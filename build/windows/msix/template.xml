<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hyperion-downloader.exe"
        Arguments=""
        InstallLocation="C:\Program Files\meponder\Hyperion Downloader">
    </Installer>
    <PackageInformation
        PackageName="Hyperion Downloader"
        PackageDisplayName="Hyperion Downloader"
        PublisherName="CN=meponder"
        PublisherDisplayName="meponder"
        Version="0.1.2.0"
        PackageDescription="A multi-threaded downloader built with Go and Wails.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.meponder.hyperiondownloader"
                Description="A multi-threaded downloader built with Go and Wails."
                DisplayName="Hyperion Downloader"
                ExecutableName="hyperion-downloader.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hyperion Downloader</DisplayName>
            <PublisherDisplayName>meponder</PublisherDisplayName>
            <Description>A multi-threaded downloader built with Go and Wails.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hyperion-downloader.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
